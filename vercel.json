{
  "version":2,
  "framework":null,
  "buildCommand":"node site-v3/stage-root.cjs",
  "installCommand":"",
  "outputDirectory":"dist",
  "headers":[
    {"source":"/(.*)","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow"},{"key":"X-Content-Type-Options","value":"nosniff"}]},
    {"source":"/site-v3/published/assets/(.*)","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]}
  ]
}
